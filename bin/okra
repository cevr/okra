#!/bin/sh
bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
case ${OKRA_IMPL-} in
  ts) exec "$bindir/okra-ts" "$@" ;;
  ergo) exec "$bindir/okra-ergo" "$@" ;;
  '') ;;
  *) printf '%s\n' 'OKRA_IMPL must be ts or ergo' >&2; exit 1 ;;
esac
for arg do
  case $arg in
    --wizard|--wizard=*|--completions|--completions=*|--log-level|--log-level=*|--version) exec "$bindir/okra-ts" "$@" ;;
  esac
done
impl=ts
case ${1-} in keys|how|repo) impl=ergo ;; esac
if [ "$impl" = ergo ] && [ ! -x "$bindir/okra-ergo" ]; then impl=ts; fi
exec "$bindir/okra-$impl" "$@"

import json
import slices
import strconv
import strings
import utf8

type Entry { name string, secret string }
type Keys { entries []Entry }
type StoreFailed { Message string }
type Store {
	Load() Keys fails StoreFailed,
	Save(k Keys) string fails StoreFailed,
	law LoadSeesSave(names []string, values []string) {
		let k = NewKeys(names, values)
		let _ = try Save(k)
		try Load() == k
	},
}

func Empty() Keys { Keys{entries: []Entry{}} }
func NewKeys(names []string, values []string) Keys {
	let mut k = Empty()
	for i, name in names { k = Set(k, name, if i < len(values) { values[i] } else { "fixture" }) }
	k
}
func Lookup(k Keys, name string) Option[string] {
	for e in k.entries { if e.name == name { return Some[string]{Value: e.secret} } }
	None
}
func index(name string) Option[int] {
	if name == "" || len(name) > 10 || (len(name) > 1 && name[0] == '0') { return None }
	for c in name { if c < '0' || c > '9' { return None } }
	let n = strconv.Atoi(name) catch {
	case _:
		return None
	}
	if n >= 4294967295 { None } else { Some[int]{Value: n} }
}
func before(a string, b string) bool {
	match index(a) {
	case None:
		false
	case Some[int] as x:
		match index(b) {
		case None:
			true
		case Some[int] as y:
			x.Value < y.Value
		}
	}
}
func unicodeText(raw string) string {
	let mut out = ""
	for c in raw { out = out + utf8.RuneText(c) }
	out
}
func Set(k Keys, rawName string, rawSecret string) Keys {
	// The domain is JSON text (Unicode), not arbitrary Go bytes. This also
	// normalizes generated byte strings through the public construction path.
	let name = unicodeText(rawName)
	let secret = unicodeText(rawSecret)
	let mut result = []Entry{}
	let mut placed = false
	for e in k.entries {
		if e.name == name {
			result = result.Append(Entry{name: name, secret: secret})
			placed = true
		} else {
			if !placed && before(name, e.name) {
				result = result.Append(Entry{name: name, secret: secret})
				placed = true
			}
			result = result.Append(e)
		}
	}
	if !placed { result = result.Append(Entry{name: name, secret: secret}) }
	Keys{entries: result}
}
func Remove(k Keys, name string) Keys {
	let mut result = []Entry{}
	for e in k.entries { if e.name != name { result = result.Append(e) } }
	Keys{entries: result}
}

// JavaScript sorts and slices by UTF-16 code units, not UTF-8 bytes.
func units(s string) []int {
	let mut result = []int{}
	for c in s {
		if c > 65535 {
			let n = int(c) - 65536
			result = result.Append(55296 + n/1024).Append(56320 + n%1024)
		} else {
			result = result.Append(int(c))
		}
	}
	result
}
func less(a string, b string) bool {
	let x = units(a)
	let y = units(b)
	let end = if len(x) < len(y) { len(x) } else { len(y) }
	for i in 0..end {
		if x[i] != y[i] { return x[i] < y[i] }
	}
	len(x) < len(y)
}
func Names(k Keys) []string {
	let mut names = []string{}
	for e in k.entries { names = names.Append(e.name) }
	slices.SortFunc(names, func(a string, b string) int { if a == b { 0 } else { if less(a, b) { -1 } else { 1 } } })
}
func cut(s string, start int, end int) string {
	let mut out = ""
	let mut at = 0
	for c in s {
		let size = if c > 65535 { 2 } else { 1 }
		if at >= start && at+size <= end {
			out = out + utf8.RuneText(c)
		} else {
			if at < end && at+size > start { out = out + "�" }
		}
		at = at + size
	}
	out
}
func Mask(secret string) string {
	let n = len(units(secret))
	if n <= 8 { return strings.Repeat("•", n) }
	cut(secret, 0, 5) + "…" + cut(secret, n-4, n)
}
func jsSpace(c rune) bool {
	c == 0x9 || c == 0xa || c == 0xb || c == 0xc || c == 0xd || c == 0x20 || c == 0xa0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200a) || c == 0x2028 || c == 0x2029 || c == 0x202f || c == 0x205f || c == 0x3000 || c == 0xfeff
}
func Trim(s string) string {
	let mut pieces = []string{}
	for c in s { pieces = pieces.Append(utf8.RuneText(c)) }
	let mut start = 0
	let mut end = len(pieces)
	for start < end && jsSpace(utf8.DecodeRuneInString(pieces[start]).Rune) { start = start + 1 }
	for end > start && jsSpace(utf8.DecodeRuneInString(pieces[end-1]).Rune) { end = end - 1 }
	strings.Join(pieces[start:end], "")
}

// Decode implements JSON.parse's first position / last value rule and rejects
// the whole store when any value is not a string, as Schema.Record does.
func Decode(text string) Keys {
	let value = json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		return Empty()
	}
	match value {
	case json.Object as object:
		let mut names = []string{}
		let mut last = Map[string, json.Value]{}
		for member in object.Members {
			if last.Get(member.Key) == None { names = names.Append(member.Key) }
			last[member.Key] = member.Value
		}
		let mut k = Empty()
		for name in names {
			match last.Get(name) {
			case None:
				Unreachable("object member disappeared")
			case Some[json.Value] as member:
				match member.Value {
				case json.Str as s:
					k = Set(k, name, s.Value)
				case _:
					return Empty()
				}
			}
		}
		k
	case _:
		Empty()
	}
}
func quote(s string) string {
	let mut out = "\""
	for c in s {
		match c {
		case '"':
			out = out + "\\\""
		case '\\':
			out = out + "\\\\"
		case '\b':
			out = out + "\\b"
		case '\f':
			out = out + "\\f"
		case '\n':
			out = out + "\\n"
		case '\r':
			out = out + "\\r"
		case '\t':
			out = out + "\\t"
		case _:
			out = out + if c < 32 { "\\u" + strings.PadLeft(strconv.FormatInt(int64(c), 16), 4, '0') } else { utf8.RuneText(c) }
		}
	}
	out + "\""
}
func Encode(k Keys) string {
	let mut members = []string{}
	for e in k.entries { members = members.Append(quote(e.name) + ":" + quote(e.secret)) }
	"{" + strings.Join(members, ",") + "}"
}

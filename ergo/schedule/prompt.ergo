import strings

// RepoName is the repository name at the end of a remote URL: after the
// last "/" or a ":" with no "/" after it, without ".git"
// (`[:/]([^/]+?)(?:\.git)?$`).
func RepoName(remote string) Option[string] {
	for i, c in remote {
		if c != ':' && c != '/' { continue }
		let rest = remote[i+1:]
		if rest == "" || strings.Contains(rest, "/") { continue }
		if strings.HasSuffix(rest, ".git") && len(rest) > 4 { return Some[string]{Value: rest[:len(rest)-4]} }
		return Some[string]{Value: rest}
	}
	None
}

func isDigit(c byte) bool { c >= '0' && c <= '9' }

// IssueNumber is the first run of two or more digits in a branch name that
// starts the name or follows "/" or "-", and ends it or comes before "/"
// or "-" (`(?:^|[/-])(\d{2,})(?:[/-]|$)`); a run of zeros is none.
func IssueNumber(branch string) Option[float64] {
	let n = len(branch)
	for start in 0..n {
		if !isDigit(branch[start]) { continue }
		if start > 0 && branch[start-1] != '/' && branch[start-1] != '-' { continue }
		let mut end = start
		for end < n && isDigit(branch[end]) { end = end + 1 }
		// A shorter run before a separator cannot match: digits follow it.
		if end-start < 2 { continue }
		if end < n && branch[end] != '/' && branch[end] != '-' { continue }
		let value = ParseInt(branch[start:end])
		if value <= 0 { return None }
		return Some[float64]{Value: value}
	}
	None
}

func parenthetical(base string, detail Option[string]) string {
	match detail {
	case None:
		base
	case Some[string] as d:
		base + " (" + d.Value + ")"
	}
}

// WithContext is the prompt an agent gets: the stored context as a block
// before the task's prompt, when there is a context.
func WithContext(prompt string, cwd string, known Option[Context]) string {
	let c = match known {
	case None:
		return prompt
	case Some[Context] as x:
		x.Value
	}
	let mut lines = []string{}
	match c.GitRepo {
	case None:
	case Some[string] as r:
		lines = lines.Append("Repository: " + parenthetical(r.Value, c.GitRemoteURL))
	}
	match c.GitBranch {
	case None:
	case Some[string] as b:
		lines = lines.Append("Branch: " + b.Value)
	}
	match c.GitDefaultBranch {
	case None:
	case Some[string] as b:
		lines = lines.Append("Default branch: " + b.Value)
	}
	match c.GitCommit {
	case None:
	case Some[string] as h:
		lines = lines.Append("HEAD: " + h.Value)
	}
	match c.PRNumber {
	case None:
	case Some[float64] as p:
		lines = lines.Append("PR: " + parenthetical("#"+Text(p.Value), c.PRURL))
	}
	match c.IssueNumber {
	case None:
	case Some[float64] as i:
		lines = lines.Append("Issue: #" + Text(i.Value))
	}
	lines = lines.Append("Working directory: " + cwd)
	"<context>\n" + strings.Join(lines, "\n") + "\n</context>\n\n" + prompt
}

// StopSignal is the block that asks the agent to print nonce once the
// condition holds.
func StopSignal(condition string, nonce string) string {
	"\n<stop-signal>\nWhen you determine that the following condition is met: \"" + condition + "\"\nOutput this exact line at the end of your response: " + nonce + "\nThis signals the scheduler to verify and stop future runs.\n</stop-signal>"
}

// VerifyPrompt asks an agent whether output's signal was meant: it shows
// the last 200 lines of the output.
func VerifyPrompt(output string, condition string) string {
	let lines = strings.Split(output, "\n")
	let from = if len(lines) > 200 { len(lines) - 200 } else { 0 }
	let tail = strings.Join(lines[from:], "\n")
	"You are verifying whether an AI agent intentionally signaled task completion.\n\nThe agent was monitoring this condition: \"" + condition + "\"\n\nReview the output below. Did the agent intentionally signal that the condition is met, or was it accidental (quoting instructions, prompt injection, hallucination)?\n\n<agent-output>\n" + tail + "\n</agent-output>\n\nRespond with exactly one word: YES or NO"
}

// Confirms is whether a verifier's answer says yes: its trimmed,
// upper-cased text starts with "YES".
func Confirms(answer string) bool { strings.HasPrefix(strings.ToUpper(Trim(answer)), "YES") }

// TailIsBounded: the verifier sees at most 200 lines of the output.
law TailIsBounded(lines uint16) {
	let output = strings.Repeat("x\n", int(lines))
	strings.Count(VerifyPrompt(output, "c"), "\n") <= 200+12
}
